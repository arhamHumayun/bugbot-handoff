{
  "manifest_version": 3,
  "name": "Bugbot Handoff",
  "description": "Adds Open with Codex and Open with Claude Code buttons next to Cursor Bugbot comments on GitHub and sends the finding into Codex or Claude Code.",
  "version": "1.0.0",
  "action": {
    "default_title": "Bugbot Handoff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/lib/shared.js",
        "src/github/content.js"
      ],
      "css": [
        "src/github/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
